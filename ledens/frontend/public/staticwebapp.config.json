{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/api/*",
      "/assets/*",
      "/*.{png,jpg,jpeg,gif,svg,ico,webp,js,css,woff,woff2,ttf,otf,eot,map,txt,xml,json}"
    ]
  },
  "routes": [
    {
      "route": "/movil/_expo/*",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/movil/assets/*",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/movil/",
      "headers": {
        "cache-control": "no-cache"
      }
    },
    {
      "route": "/movil/index.html",
      "headers": {
        "cache-control": "no-cache"
      }
    },
    {
      "route": "/movil/acceso*",
      "rewrite": "/movil/index.html",
      "headers": {
        "cache-control": "no-cache"
      }
    },
    {
      "route": "/movil/admin*",
      "rewrite": "/movil/index.html",
      "headers": {
        "cache-control": "no-cache"
      }
    },
    {
      "route": "/movil/jefe*",
      "rewrite": "/movil/index.html",
      "headers": {
        "cache-control": "no-cache"
      }
    },
    {
      "route": "/movil/cliente*",
      "rewrite": "/movil/index.html",
      "headers": {
        "cache-control": "no-cache"
      }
    },
    {
      "route": "/assets/*",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    }
  ],
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "camera=(self), microphone=(), geolocation=()"
  },
  "mimeTypes": {
    ".json": "application/json"
  }
}
