{
  "openapi": "3.0.3",
  "info": {
    "title": "Ledens Bridge workspace",
    "version": "1.0.0",
    "description": "Existing ledens_session authentication; admin role for global bank reconciliation. No new roles or credentials. Monetary strings preserve cents; document and bank amounts use their ledger sign. Manual requested amount is positive. API is independent of React."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "session": []
    }
  ],
  "paths": {
    "/api/bridge/workspace/counts": {
      "get": {
        "description": "Pending bank movement count; same exclusion rules as the pending list.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Counts"
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameters or confirmation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Session missing or expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Administrator required; writes also require matching Origin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Document, case or bank movement not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Stale fingerprint/version, insufficient balance, reserved link or conflicting idempotent replay; refresh and select again",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Service temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/bridge/workspace/movements": {
      "get": {
        "description": "One row per bank movement without complete confirmed coverage or with review links. Excludes internal transfers and reserved worker batches.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 120
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 25
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000,
              "default": 0
            }
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MovementPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameters or confirmation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Session missing or expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Administrator required; writes also require matching Origin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Document, case or bank movement not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Stale fingerprint/version, insufficient balance, reserved link or conflicting idempotent replay; refresh and select again",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Service temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/bridge/workspace/allocations": {
      "get": {
        "description": "Actual Bridge rows, including confirmed and review states. Search by document, party and movement.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 120
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 25
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000,
              "default": 0
            }
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AllocationPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameters or confirmation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Session missing or expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Administrator required; writes also require matching Origin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Document, case or bank movement not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Stale fingerprint/version, insufficient balance, reserved link or conflicting idempotent replay; refresh and select again",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Service temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/bridge/workspace/movements/{bankId}/documents": {
      "get": {
        "description": "Available existing documents; no document creation and no GET-side writes. Includes document version and fingerprint for Save.",
        "parameters": [
          {
            "name": "bankId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 120
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 25
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameters or confirmation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Session missing or expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Administrator required; writes also require matching Origin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Document, case or bank movement not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Stale fingerprint/version, insufficient balance, reserved link or conflicting idempotent replay; refresh and select again",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Service temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/bridge/{documentId}/confirm": {
      "post": {
        "description": "Reuses the existing transactional Bridge confirmation. Applies a positive amount with the chosen payment/collection direction. Only unlinked documents can have their direction corrected; before/after values, actor and reason are audited. Fully covered bank movements leave the pending list. Use a stable request_id on retry after an uncertain response.",
        "parameters": [
          {
            "name": "documentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Confirmation"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved or idempotently replayed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Confirmed"
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameters or confirmation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Session missing or expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Administrator required; writes also require matching Origin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Document, case or bank movement not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Stale fingerprint/version, insufficient balance, reserved link or conflicting idempotent replay; refresh and select again",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Service temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "ledens_session"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "Counts": {
        "type": "object",
        "properties": {
          "pending": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "pending"
        ]
      },
      "Movement": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "completed_on": {
            "type": "string",
            "format": "date"
          },
          "total_amount": {
            "type": "string",
            "pattern": "^-?[0-9]+(?:\\.[0-9]{1,2})?$"
          },
          "confirmed": {
            "type": "string",
            "pattern": "^-?[0-9]+(?:\\.[0-9]{1,2})?$"
          },
          "remaining": {
            "type": "string",
            "pattern": "^-?[0-9]+(?:\\.[0-9]{1,2})?$"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "reference": {
            "type": "string",
            "nullable": true
          },
          "documents": {
            "type": "string",
            "nullable": true
          },
          "state": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "links": {
            "type": "integer"
          },
          "review_links": {
            "type": "integer"
          },
          "bank_fingerprint": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "total_amount",
          "remaining",
          "bank_fingerprint"
        ]
      },
      "Document": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "numerodocumento": {
            "type": "string",
            "nullable": true
          },
          "document_on": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "tercero": {
            "type": "string",
            "nullable": true
          },
          "tipo": {
            "type": "string",
            "nullable": true
          },
          "total": {
            "type": "string",
            "pattern": "^-?[0-9]+(?:\\.[0-9]{1,2})?$"
          },
          "remaining": {
            "type": "string",
            "pattern": "^-?[0-9]+(?:\\.[0-9]{1,2})?$"
          },
          "version": {
            "type": "integer",
            "minimum": 0
          },
          "document_fingerprint": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "total",
          "remaining",
          "version",
          "document_fingerprint"
        ]
      },
      "Allocation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "document_id": {
            "type": "string",
            "format": "uuid"
          },
          "bank_movement_id": {
            "type": "string",
            "format": "uuid"
          },
          "allocated_amount": {
            "type": "string",
            "pattern": "^-?[0-9]+(?:\\.[0-9]{1,2})?$"
          },
          "state": {
            "type": "string"
          },
          "reconciled_on": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "numerodocumento": {
            "type": "string",
            "nullable": true
          },
          "tercero": {
            "type": "string",
            "nullable": true
          },
          "bank_total": {
            "type": "string",
            "pattern": "^-?[0-9]+(?:\\.[0-9]{1,2})?$"
          },
          "document_total": {
            "type": "string",
            "pattern": "^-?[0-9]+(?:\\.[0-9]{1,2})?$"
          },
          "completed_on": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "currency": {
            "type": "string"
          },
          "observaciones": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "document_id",
          "bank_movement_id",
          "allocated_amount",
          "state"
        ]
      },
      "Confirmation": {
        "type": "object",
        "properties": {
          "bank_movement_id": {
            "type": "string",
            "format": "uuid"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer",
            "minimum": 0
          },
          "document_fingerprint": {
            "type": "string"
          },
          "bank_fingerprint": {
            "type": "string"
          },
          "amount": {
            "type": "string",
            "pattern": "^[0-9]+(?:\\.[0-9]{1,2})?$",
            "description": "Positive amount to apply, not the signed bank amount; must be greater than zero and no greater than either available balance."
          },
          "currency": {
            "type": "string",
            "enum": [
              "EUR"
            ]
          },
          "tipo": {
            "type": "string",
            "enum": [
              "Pagar",
              "Cobrar"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 5,
            "maxLength": 1000
          }
        },
        "required": [
          "bank_movement_id",
          "request_id",
          "version",
          "document_fingerprint",
          "bank_fingerprint",
          "amount",
          "currency",
          "tipo",
          "reason"
        ]
      },
      "Confirmed": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "confirmed",
              "partial"
            ]
          },
          "allocation_id": {
            "type": "string",
            "format": "uuid"
          },
          "replay": {
            "type": "boolean"
          }
        },
        "required": [
          "status",
          "allocation_id",
          "replay"
        ]
      },
      "MovementPage": {
        "type": "object",
        "properties": {
          "rows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Movement"
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          }
        },
        "required": [
          "rows",
          "total",
          "limit",
          "offset"
        ]
      },
      "DocumentPage": {
        "type": "object",
        "properties": {
          "rows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Document"
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          }
        },
        "required": [
          "rows",
          "total",
          "limit",
          "offset"
        ]
      },
      "AllocationPage": {
        "type": "object",
        "properties": {
          "rows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Allocation"
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          }
        },
        "required": [
          "rows",
          "total",
          "limit",
          "offset"
        ]
      }
    }
  }
}
