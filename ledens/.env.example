# ── Local Docker Compose (docker compose up) ─────────────────────────────

# Host port that nginx (frontend container) is exposed on.
HOST_PORT=8080

# CORS origin allowed by the backend.
# For local docker compose: the nginx host URL is fine.
# In production this is set automatically by infra/setup.sh to the SWA URL.
CORS_ORIGIN=http://localhost:8080

# Where the backend stores leads.jsonl  (default: /data inside the container).
# Useful to override in local dev if you want a specific host path.
# DATA_DIR=/data

# ── PostgreSQL (users / auth) ────────────────────────────────────────────
# Local dev database container ("db" in docker-compose.yml). Use letters and
# digits only — the password is embedded in DATABASE_URL.
# POSTGRES_PASSWORD=ledens_dev_password
# Host port the local database is published on (localhost only).
# DB_HOST_PORT=5432

# Connection string. docker-compose builds this for the backend container;
# set it yourself only when running the backend outside Docker (npm run dev).
# If unset, the backend starts normally and database features stay disabled.
# DATABASE_URL=postgres://ledens:ledens_dev_password@localhost:5432/ledens
#
# Set to "true" when the server requires TLS (Azure Database for PostgreSQL).
# DATABASE_SSL=true

# ── Google login (issue #11) ─────────────────────────────────────────────
# From a Google Cloud Console OAuth 2.0 Client ID — not created yet (needs a
# decision on which Google account should own it; see the build log).
# Blank/unset => /api/auth/google responds "not configured" instead of
# crashing, same as DATABASE_URL above.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Must exactly match a redirect URI registered in the Google Cloud Console.
# Local docker compose: http://localhost:8080/api/auth/google/callback
# GOOGLE_REDIRECT_URI=

# ── Microsoft login (issue #12) ──────────────────────────────────────────
# From an Entra app registration (Azure Portal → App registrations) — not
# created yet, same "not configured" degrade as Google above.
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# Local docker compose: http://localhost:8080/api/auth/microsoft/callback
# MICROSOFT_REDIRECT_URI=


# ── Production / CI — set these in GitHub Secrets, not here ──────────────
#
# AZURE_CREDENTIALS          Service principal JSON for GitHub Actions.
#                            az ad sp create-for-rbac --sdk-auth
#                            (see ledens/infra/deploy-new-subscription.sh for the full command)
#
# AZURE_STATIC_WEB_APPS_API_TOKEN  Deployment token for the SWA.
#                            Azure Portal → Static Web Apps → swa-ledens
#                            → Manage deployment token
#
# DATABASE_URL / GOOGLE_* / MICROSOFT_* in production live in Key Vault and
# reach the Container App as secret references (infra/setup-database.sh).
# JWT_SECRET also lives there but is unused by this codebase (sessions are
# DB-backed, not JWT — see CLAUDE.md).
#
# These are already configured in .github/workflows/. Do NOT put real values
# in this file or commit them — GitHub Secrets is the right place.
